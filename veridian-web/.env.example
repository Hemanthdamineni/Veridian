# Veridian web app environment — SQLite edition (local development default).
#
# Copy to .env.local and adjust values. For local work the default DATABASE_URL
# is the SQLite file the Prisma schema targets:
#
#   cp .env.example .env.local
#   npm run db:generate
#   npm run db:push
#
# For a PostgreSQL deployment, copy .env.postgres.example instead. Placeholders
# only — never commit a real ADMIN_TOKEN or a live DATABASE_URL. This file is
# un-ignored so it stays tracked; real .env* files are ignored by .gitignore.
# The repo-level .env.example (../.env.example) is the same contract for the
# package-level workflow documented in the root README.

# SQLite database for local work. The Prisma schema in prisma/schema.prisma is
# the single source of truth; schema.postgres.prisma is derived from it.
DATABASE_URL="file:./dev.db"

# Single shared admin bearer token guarding /admin and /api/admin. Set a long
# random value for any deployment that exposes those routes. Do not commit the
# real value. Example: openssl rand -hex 32
ADMIN_TOKEN=""

# Public base URL of the deployed site, used to build absolute links.
# Example: "http://localhost:3000" for local work.
NEXT_PUBLIC_SITE_URL=""

# Runtime environment. "development" for local work; "production" for deploy.
NODE_ENV="development"

# ENERGY STAR ingest tuning (npm run db:ingest:es). ENERGY_STAR_TYPES is a
# comma-separated list of supported product types (e.g. "Notebook"). Omit both
# to ingest the full cited dataset. ENERGY_STAR_LIMIT is an optional integer
# from 1 to 1000 restricting the first N rows per type — use it for a fast
# development ingest, never for a full catalog load.
ENERGY_STAR_TYPES="Notebook"
ENERGY_STAR_LIMIT=""

# Best Buy Products API key (npm run db:retail-prices). Optional: when set, the
# retail price refresh reads live Best Buy prices through the official API; when
# empty, the refresh is a dry run by default and every source row is skipped
# rather than guessed. Obtain a key from the Best Buy Developer Program.
BEST_BUY_API_KEY=""