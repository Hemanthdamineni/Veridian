// Veridian Database Schema - SQLite version for local development/testing
// This is a simplified schema compatible with SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// CORE PRODUCT TABLES
// =============================================================================

model Manufacturer {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  country    String?
  websiteUrl String?
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  series Series[]
}

model Series {
  id             String   @id @default(cuid())
  manufacturerId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  models       Model[]

  @@unique([manufacturerId, slug])
}

model Model {
  id            String   @id @default(cuid())
  seriesId      String
  name          String
  slug          String
  launchDate    DateTime?
  productUrl    String?
  discontinued  Boolean  @default(false)
  successorId   String?
  predecessorId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  skus   Sku[]

  @@unique([seriesId, slug])
}

model Sku {
  id                String   @id @default(cuid())
  modelId           String
  skuCode           String   @unique
  cpuBrand          String
  cpuModel          String
  cpuCores          Int?
  gpuModel          String?
  ramGb             Int
  ramType           String
  ramSoldered       Boolean
  storageGb         Int
  storageType       String
  storageSlots      Int?
  displaySizeIn     Float
  displayResolution String
  displayType       String
  displayRefreshHz  Int
  displayTouch      Boolean
  displayNits       Int?
  weightKg          Float
  batteryWh         Float
  batteryLifeHours  Float?
  npuTops           Float?
  os                String
  buildMaterial     String
  linuxCompat       String?
  launchDate        DateTime?
  discontinued      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  model         Model              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  pricing           SkuRegionalPricing[]
  priceObservations PriceObservation[]
  ports             SkuPort[]
  contributions     Contribution[]
  alerts            Alert[]

  @@index([ramGb])
  @@index([storageGb])
  @@index([weightKg])
  @@index([batteryWh])
  @@index([displayRefreshHz])
  @@index([cpuBrand])
  @@index([displayType])
}

model SkuRegionalPricing {
  id        String   @id @default(cuid())
  skuId     String
  region    String
  currency  String
  msrp      Float
  available Boolean  @default(true)
  storeUrl  String?
  updatedAt DateTime @updatedAt

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, region])
}

model SkuPort {
  id       String @id @default(cuid())
  skuId    String
  portType String
  count    Int

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model PriceObservation {
  id         String   @id @default(cuid())
  skuId      String
  region     String
  currency   String
  price      Float
  retailer   String?
  sourceUrl  String?
  timestamp  DateTime @default(now())
  sourceName String?
  confidence Float    @default(0.8)

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, timestamp])
  @@index([skuId, region])
}

// =============================================================================
// USER & COMMUNITY TABLES
// =============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("user")
  reputation    Int      @default(0)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contributions Contribution[]
  alerts        Alert[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contribution {
  id             String   @id @default(cuid())
  userId         String
  skuId          String
  type           String
  field          String?
  oldValue       String?
  newValue       String
  evidenceUrl    String?
  evidenceText   String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model Alert {
  id            String   @id @default(cuid())
  userId        String
  skuId         String
  region        String
  conditionType String
  thresholdValue Float
  channel       String
  active        Boolean  @default(true)
  lastTriggered DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku  Sku  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skuId])
}
