  sku     Sku             @relation(fields: [skuId], references: [id], onDelete: Cascade)
  @@index([skuId, scrapedAt])
  @@index([listingId])
  @@map("price_history")
}

model PriceObservation {
  id         String   @id @default(uuid()) @db.Uuid
